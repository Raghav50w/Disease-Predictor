# Normalise line endings. Development happens on Windows; CI, Docker, and
# Render all run Linux, so everything is stored as LF in the repository.
* text=auto eol=lf

# Datasets are data, not source - never touch their bytes.
*.csv text eol=lf
datasets/raw/*.data -text

# Binary artifacts (not committed, but be explicit).
*.pkl binary
*.png binary
*.jpg binary
*.ico binary
